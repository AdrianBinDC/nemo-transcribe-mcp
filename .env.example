# --- Model endpoint (already running; this app does not start it) ---
# Without Docker (uvx / local process on the host):
#   NEMOTRON_BASE_URL=http://127.0.0.1:8010/v1
# With Docker Compose on the same machine (Linux):
#   NEMOTRON_BASE_URL=http://host.docker.internal:8010/v1
# Inside a container, 127.0.0.1 is the container itself — not your host.
NEMOTRON_BASE_URL=http://127.0.0.1:8010/v1

# Served model id. Optional. The package default is the Nemotron 3.5 Transcribe model.
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-NVFP4

# Optional. Leave blank when the server does not require a key.
NEMOTRON_API_KEY=

# DEBUG, INFO, WARNING, or ERROR.
NEMOTRON_LOG_LEVEL=INFO

# json is one object per line, which Docker and log collectors can read.
# text is one readable line for a terminal.
NEMOTRON_LOG_FORMAT=json

# Language codes:
# ar Arabic      bg Bulgarian   zh Chinese     hr Croatian
# cs Czech       da Danish      nl Dutch       en English
# et Estonian    fi Finnish     fr French      de German
# el Greek       he Hebrew      hi Hindi       hu Hungarian
# it Italian     ja Japanese    ko Korean      lv Latvian
# lt Lithuanian  mt Maltese     pl Polish      pt Portuguese
# ro Romanian    ru Russian     sk Slovak      sl Slovenian
# es Spanish     sv Swedish     th Thai        uk Ukrainian

# One of these two languages must be English.
# Language spoken in the audio file. This is the source.
# Leave blank to listen to the file and decide.
NEMOTRON_SOURCE_LANGUAGE=

# Language the translated words should be written in. This is the destination.
NEMOTRON_TARGET_LANGUAGE=en

# --- MCP transport (Compose sets http; local CLI defaults to stdio) ---
# stdio = client launches this process. http = long-lived Streamable HTTP server.
MCP_TRANSPORT=stdio

# Listen address inside the process/container. Compose sets 0.0.0.0.
MCP_HOST=127.0.0.1

# Port the MCP process listens on (inside the container this stays 8080).
MCP_PORT=8080

# Host port published by Compose (Spark: 8080-8082 were busy; 8083 is the default).
# Hermes URL: http://127.0.0.1:${MCP_HOST_PORT}/mcp
MCP_HOST_PORT=8083

# Required when MCP_TRANSPORT=http. Hermes sends: Authorization: Bearer <this value>
MCP_AUTH_TOKEN=

# Docker data folders (Compose sets these). Jobs and downloads go under WORK_ROOT.
# AUDIO_ROOT=/data/audio
WORK_ROOT=
