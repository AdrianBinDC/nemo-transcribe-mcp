# Address of an already-running Nemotron 3.5 Transcribe server.
NEMOTRON_BASE_URL=http://127.0.0.1:8000/v1

# Served model id. Optional. The package default is the Nemotron 3.5 Transcribe model.
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-NVFP4

# Optional. Leave blank when the server does not require a key.
NEMOTRON_API_KEY=

# DEBUG, INFO, WARNING, or ERROR.
NEMOTRON_LOG_LEVEL=INFO

# json is one object per line, which Docker and log collectors can read.
# text is one readable line for a terminal.
NEMOTRON_LOG_FORMAT=json
